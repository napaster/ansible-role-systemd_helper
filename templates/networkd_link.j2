{{ '## ' ~ network_netdev_name ~ '.link' }}
{{ '# ' + ansible_managed }}
{{ '# Do not edit manually' }}

{{ '[Match]' }}
{% if item['match_override'] is defined and item['match_override']
  not in ['', [], '[]', None] %}
{% for m in item['match_override'] %}
{% if (m.match_entry is defined and m['match_entry']
  not in ['', [], '[]', None]) and
  (m.match_value is defined and m['match_value']
  not in ['', [], '[]', None]) %}
{{ m['match_entry'] ~ '=' ~ m['match_value'] }}
{% endif %}
{% endfor %}
{% else %}
{% if network_netdev_kind is defined and network_netdev_kind in ['vlan',
  'macvlan'] %}
{{ 'OriginalName=' + network_netdev_name }}
{% else %}
{{ 'MACAddress=' + (item['physaddr'] | ansible.utils.hwaddr('linux')) }}
{% endif %}
{% endif %}
{{ '' }}
{{ '[Link]' }}
{% if network_netdev_kind is defined and network_netdev_kind !=
  ['vlan', 'macvlan'] %}
{% if (item['match_override'] is defined and
  item['match_override'] in ['', [], '[]', None]) or item['match_override'] is
  not defined %}
{{ 'Name=' ~ network_netdev_name }}
{% endif %}
{% endif %}
{% if item['description'] is defined and item['description']
  not in ['', [], '[]', None] %}
{{ 'Description=' ~ item['description'] }}
{% endif %}
{% if item['alias'] is defined and item['alias'] not in ['', [], '[]', None] %}
{{ 'Alias=' ~ item['alias'] }}
{% endif %}
{% if item['macaddr_policy'] is defined and item['macaddr_policy'] in
  ['persistent', 'random', 'never'] %}
{{ 'MACAddressPolicy=' + item['macaddr_policy'] }}
{% endif %}
{% if item['macaddr'] is defined and item['macaddr'] | ansible.utils.hwaddr() %}
{{ 'MACAddress=' + item['macaddr'] | ansible.utils.hwaddr('linux') }}
{% endif %}
{% if item['altname_policy'] is defined and item['altname_policy'] in
  ['database', 'onboard', 'slot', 'path', 'mac'] %}
{{ 'AlternativeNamesPolicy=' + (item['altname_policy'] | join(' ')) }}
{% endif %}
{% if item['altname'] is defined and item['altname']
  not in ['', [], '[]', None] %}
{% if item['altname'] is string %}
{{ 'AlternativeName=' + item['altname'] }}
{% elif item['altname'] is sequence %}
{% for a in item['altname'] %}
{{ 'AlternativeName=' + a }}
{% endfor %}
{% endif %}
{% endif %}
{% if item['txqueuelen'] is defined and item['txqueuelen']
  not in ['', [], '[]', None] %}
{{ 'TransmitQueueLength=' ~ item['txqueuelen'] }}
{% endif %}
{% if item['mtu'] is defined and item['mtu'] not in ['', [], '[]', None] %}
{{ 'MTUBytes=' ~ item['mtu'] }}
{% endif %}
{% if item['speed'] is defined and item['speed'] not in ['', [], '[]', None] %}
{{ 'BitsPerSecond=' ~ item['speed'] }}
{% endif %}
{% if item['duplex'] is defined and item['duplex'] in ['half', 'full'] %}
{{ 'Duplex=' + item['duplex'] }}
{% endif %}
{% if item['autoneg'] is defined and item['autoneg'] in ['true', 'false'] %}
{{ 'AutoNegotiation=' + item['autoneg'] }}
{% endif %}
{% if item['won'] is defined and item['won'] in ['phy', 'unicast', 'multicast',
  'broadcast', 'arp', 'magic', 'secureon', 'off'] %}
{{ 'WakeOnLan=' + item['won'] }}
{% endif %}
{% if item['port'] is defined and item['port'] in ['tp', 'aui', 'bnc', 'mii',
  'fiber'] %}
{{ 'Port=' + item['port'] }}
{% endif %}
{% if item['negotiation'] is defined and item['negotiation']
  not in ['', [], '[]', None] %}
{{ 'Advertise=' + item['negotiation'] }}
{% endif %}
{% if item['eth_rx'] is defined and item['eth_rx'] in ['true', 'false'] %}
{{ 'ReceiveChecksumOffload=' + item['eth_rx'] }}
{% endif %}
{% if item['eth_tx'] is defined and item['eth_tx'] in ['true', 'false'] %}
{{ 'TransmitChecksumOffload=' + item['eth_tx'] }}
{% endif %}
{% if item['eth_tso'] is defined and item['eth_tso'] in ['true', 'false'] %}
{{ 'TCPSegmentationOffload=' + item['eth_tso'] }}
{% endif %}
{% if item['eth_tso6'] is defined and item['eth_tso6'] in ['true', 'false'] %}
{{ 'TCP6SegmentationOffload=' + item['eth_tso6'] }}
{% endif %}
{% if item['eth_gso'] is defined and item['eth_gso'] in ['true', 'false'] %}
{{ 'GenericSegmentationOffload=' + item['eth_gso'] }}
{% endif %}
{% if item['eth_gro'] is defined and item['eth_gro'] in ['true', 'false'] %}
{{ 'GenericReceiveOffload=' + item['eth_gro'] }}
{% endif %}
{% if item['eth_lro'] is defined and item['eth_lro'] in ['true', 'false'] %}
{{ 'LargeReceiveOffload=' + item['eth_lro'] }}
{% endif %}
{% if item['eth_rxvlan'] is defined and item['eth_rxvlan'] in
  ['true', 'false'] %}
{{ 'ReceiveVLANCTAGHardwareAcceleration=' + item['eth_rxvlan'] }}
{% endif %}
{% if item['eth_txvlan'] is defined and item['eth_txvlan'] in
  ['true', 'false'] %}
{{ 'TransmitVLANCTAGHardwareAcceleration=' + item['eth_txvlan'] }}
{% endif %}
{% if item['eth_rx_vlan_filter'] is defined and item['eth_rx_vlan_filter'] in
  ['true', 'false'] %}
{{ 'ReceiveVLANCTAGFilter=' + item['eth_rx_vlan_filter'] }}
{% endif %}
{% if item['eth_tx_vlan_stag'] is defined and item['eth_tx_vlan_stag'] in
  ['true', 'false'] %}
{{ 'TransmitVLANSTAGHardwareAcceleration=' + item['eth_tx_vlan_stag'] }}
{% endif %}
{% if item['eth_rx_ntuple_filter'] is defined and
  item['eth_rx_ntuple_filter'] in ['true', 'false'] %}
{{ 'NTupleFilter=' + item['eth_rx_ntuple_filter'] }}
{% endif %}
{% if item['eth_rx_channels'] is defined and item['eth_rx_channels']
  not in ['', [], '[]', None] %}
{{ 'RxChannels=' ~ item['eth_rx_channels'] }}
{% endif %}
{% if item['eth_tx_channels'] is defined and item['eth_tx_channels']
  not in ['', [], '[]', None] %}
{{ 'TxChannels=' ~ item['eth_tx_channels'] }}
{% endif %}
{% if item['eth_other_channels'] is defined and
  item['eth_other_channels'] not in ['', [], '[]', None] %}
{{ 'OtherChannels=' ~ item['eth_other_channels'] }}
{% endif %}
{% if item['eth_combined_channels'] is defined and
  item['eth_combined_channels'] not in ['', [], '[]', None] %}
{{ 'CombinedChannels=' ~ item['eth_combined_channels'] }}
{% endif %}
{% if item['eth_rx_ring'] is defined and item['eth_rx_ring']
  not in ['', [], '[]', None] %}
{{ 'RxBufferSize=' ~ item['eth_rx_ring'] }}
{% endif %}
{% if item['eth_tx_ring'] is defined and item['eth_tx_ring']
  not in ['', [], '[]', None] %}
{{ 'TxBufferSize=' ~ item['eth_tx_ring'] }}
{% endif %}
{% if item['eth_rx_flow'] is defined and item['eth_rx_flow'] in
  ['true', 'false'] %}
{{ 'RxFlowControl=' + item['eth_rx_flow'] }}
{% endif %}
{% if item['eth_tx_flow'] is defined and item['eth_tx_flow'] in
  ['true', 'false'] %}
{{ 'TxFlowControl=' + item['eth_tx_flow'] }}
{% endif %}
{% if item['eth_flow_control_autoneg'] is defined and
  item['eth_flow_control_autoneg'] in ['true', 'false'] %}
{{ 'AutoNegotiationFlowControl=' + item['eth_flow_control_autoneg'] }}
{% endif %}
