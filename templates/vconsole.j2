{{ '## vconsole.conf' }}
{{ '# ' + ansible_managed }}
{{ '# Do not edit manually' }}

{% for c in hostvars[inventory_hostname]['systemd_vconsole'] %}
{% if c['keymap'] is defined and c['keymap'] not in ['', [], '[]', None] %}
{{ 'KEYMAP=\"' + c['keymap'] + '\"' }}
{% endif %}
{% if c['keymap_toggle'] is defined and c['keymap_toggle']
  not in ['', [], '[]', None] %}
{{ 'KEYMAP_TOGGLE=\"' + c['keymap_toggle'] + '\"' }}
{% endif %}
{% if c['font'] is defined and c['font'] not in ['', [], '[]', None] %}
{{ 'FONT=\"' + c['font'] + '\"' }}
{% endif %}
{% if c['font_map'] is defined and c['font_map'] not in ['', [], '[]', None] %}
{{ 'FONT_MAP=\"' + c['font_map'] + '\"' }}
{% endif %}
{% if c['font_unimap'] is defined and c['font_unimap']
  not in ['', [], '[]', None] %}
{{ 'FONT_UNIMAP=\"' + c['font_unimap'] + '\"' }}
{% endif %}
{% endfor %}
