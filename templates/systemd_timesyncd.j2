{{ '## timesyncd.conf' }}
{{ '# ' + ansible_managed }}
{{ '# Do not edit manually' }}

{{ '[Time]' }}
{% for t in lookup('ansible.builtin.vars', 'systemd_timedatectl_timesyncd') %}
{% if t['ntp'] is defined and t['ntp'] not in ['', [], '[]', None] %}
{% if t['ntp'] is string %}
{{ 'NTP=' + t['ntp'] }}
{% elif t['ntp'] is sequence %}
{% for addr in t['ntp'] %}
{% if addr not in ['', [], '[]', None] %}
{% if loop['first'] %}
{{ 'NTP' + '=' -}}
{% endif %}
{{ addr -}}
{% if not loop['last'] %}
{{ ' ' -}}
{% else %}
{{ '' }}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
{% endif %}
{% if t['fallback'] is defined and t['fallback'] not in ['', [], '[]', None] %}
{% if t['fallback'] is string %}
{{ 'FallbackNTP=' + t['fallback'] }}
{% elif t['fallback'] is sequence %}
{% for addr in t['fallback'] %}
{% if addr not in ['', [], '[]', None] %}
{% if loop['first'] %}
{{ 'FallbackNTP' + '=' -}}
{% endif %}
{{ addr -}}
{% if not loop['last'] %}
{{ ' ' -}}
{% else %}
{{ '' }}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
{% endif %}
{% if t['fallback'] is defined and t['fallback'] not in ['', [], '[]', None] %}
{% if t['fallback'] is string %}
{{ 'FallbackNTP=' + t['fallback'] }}
{% elif t['fallback'] is sequence %}
{% for addr in t['fallback'] %}
{% if addr not in ['', [], '[]', None] %}
{% if loop['first'] %}
{{ 'FallbackNTP' + '=' -}}
{% endif %}
{{ addr -}}
{% if not loop['last'] %}
{{ ' ' -}}
{% else %}
{{ '' }}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
{% endif %}
{% if t['root_distance_max_sec'] is defined and t['root_distance_max_sec']
  not in ['', [], '[]', None] %}
{{ 'RootDistanceMaxSec=' ~ t['root_distance_max_sec'] }}
{% endif %}
{% if t['poll_interval_min_sec'] is defined and t['poll_interval_min_sec']
  not in ['', [], '[]', None] %}
{{ 'PollIntervalMinSec=' ~ t['poll_interval_min_sec'] }}
{% endif %}
{% if t['poll_interval_max_sec'] is defined and t['poll_interval_max_sec']
  not in ['', [], '[]', None] %}
{{ 'PollIntervalMaxSec=' ~ t['poll_interval_max_sec'] }}
{% endif %}
{% endfor %}
